# Kenora Environment Configuration

# General
NODE_ENV=development
PORT=4000
WEB_PORT=3000
WORKER_PORT=4001
LOG_LEVEL=info

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql://kenora:kenorapass@localhost:5432/kenoradb?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=kenora
DB_PASSWORD=kenorapass
DB_NAME=kenoradb

# Redis (Caching & Queues)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# NATS (Event Backbone)
NATS_URL=nats://localhost:4222

# S3 Compatible Object Storage (LocalStack / MinIO)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=kenora-artifacts
S3_REGION=us-east-1

# Auth & Security
JWT_SECRET=super-secret-kenora-jwt-token-key-change-in-production
SESSION_SECRET=super-secret-kenora-session-key

# AI Gateway (Abstracted)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
